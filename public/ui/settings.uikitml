<!--
  Panneau de reglages du prototype de sculpture.
  Pas d'accents : la police des panneaux n'en contient pas.
  Les id sont lus par src/workpiece.ts (bindSettings).
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 460px;
  }

  .panel-content {
    flex-direction: column;
    gap: 12px;
    padding: 22px;
  }

  .eyebrow {
    color: #f5d90a;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .hint {
    color: #b9bcc4;
    font-size: 16px;
  }

  .row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .label {
    color: #fafaf7;
    font-size: 22px;
    width: 150px;
  }

  .value {
    color: #fafaf7;
    font-size: 22px;
    font-weight: 700;
    width: 110px;
    text-align: center;
  }

  .step {
    width: 64px;
    justify-content: center;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">REGLAGES</div>
    <div class="row">
      <div class="label">Largeur</div>
      <Button id="w-minus" class="step"><ButtonLabel>-</ButtonLabel></Button>
      <div id="w-value" class="value">7.0 cm</div>
      <Button id="w-plus" class="step"><ButtonLabel>+</ButtonLabel></Button>
    </div>
    <div class="row">
      <div class="label">Hauteur</div>
      <Button id="h-minus" class="step"><ButtonLabel>-</ButtonLabel></Button>
      <div id="h-value" class="value">7.0 cm</div>
      <Button id="h-plus" class="step"><ButtonLabel>+</ButtonLabel></Button>
    </div>
    <div class="row">
      <div class="label">Profondeur</div>
      <Button id="d-minus" class="step"><ButtonLabel>-</ButtonLabel></Button>
      <div id="d-value" class="value">7.0 cm</div>
      <Button id="d-plus" class="step"><ButtonLabel>+</ButtonLabel></Button>
    </div>
    <div class="row">
      <div class="label">Opacite</div>
      <Button id="o-minus" class="step"><ButtonLabel>-</ButtonLabel></Button>
      <div id="o-value" class="value">40 %</div>
      <Button id="o-plus" class="step"><ButtonLabel>+</ButtonLabel></Button>
    </div>
    <div class="hint">Taille : seulement deverrouille. Opacite : mode transparent.</div>
  </div>
</Panel>
